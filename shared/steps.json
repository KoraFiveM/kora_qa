[
  {
    "id": "items.have",
    "pattern": "I have {int} {string}",
    "kind": "setup",
    "side": "server",
    "resource": "kora_qa",
    "priority": 0,
    "description": "Sets the amount of an item in my inventory to exactly N (adds or removes the difference).",
    "args": [
      {
        "name": "count",
        "type": "int",
        "cap": "maxItemCount",
        "min": 1
      },
      {
        "name": "item",
        "type": "string",
        "allow": "items"
      }
    ],
    "undo": true,
    "example": "Given I have 3 \"water\""
  },
  {
    "id": "items.have_meta",
    "pattern": "I have {int} {string} with {string} set to {string}",
    "kind": "setup",
    "side": "server",
    "resource": "kora_qa",
    "priority": 0,
    "description": "Gives N of an item with one metadata (info) field set. Existing stacks are kept.",
    "args": [
      {
        "name": "count",
        "type": "int",
        "cap": "maxItemCount",
        "min": 1
      },
      {
        "name": "item",
        "type": "string",
        "allow": "items"
      },
      {
        "name": "key",
        "type": "string",
        "allow": "metadataKeys"
      },
      {
        "name": "value",
        "type": "string",
        "maxLength": 100
      }
    ],
    "undo": true,
    "example": "Given I have 1 \"fishingrod\" with \"quality\" set to \"50\""
  },
